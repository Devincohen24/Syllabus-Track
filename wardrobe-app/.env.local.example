# ============================================================
# StyleAI — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Anthropic API Key (required for AI outfit recommendations + clothing analysis)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenWeatherMap API Key (required for weather data)
# Free tier available at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Google OAuth Credentials (optional — for Google Calendar integration)
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Add redirect URI: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your app's public URL (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
