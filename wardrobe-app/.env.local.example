# ============================================================
# StyleAI — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Supabase (required — free at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic API Key (required for AI outfit recommendations + clothing analysis)
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenWeatherMap API Key (required for weather data)
# Free tier at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Google OAuth Credentials (optional — for Google Calendar integration)
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Add redirect URI: https://your-app.vercel.app/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your deployed app URL (update after Vercel deployment)
NEXT_PUBLIC_APP_URL=http://localhost:3000
